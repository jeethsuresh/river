            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "river-turn",
                "image": "coturn/coturn:4.18.0-r0@sha256:bbefd3e1fdfdc0d58770fe01b581fd8b00d9f3a5580d00acb77cf719a6bc78e3",
                "args": [
                  "-c",
                  "/run/river/turnserver.conf",
                  "--relay-ip=$(POD_IP)",
                  "--listening-ip=$(POD_IP)"
                ],
                "ports": [
                  {
                    "name": "control",
                    "containerPort": 8443
                  }
                ],
                "env": [
                  {
                    "name": "POD_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.podIP"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/run/river",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 24
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 20,
                  "failureThreshold": 4
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "secret": {
                  "secretName": "river-turn-config",
                  "defaultMode": 288
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "river-turn",
        "namespace": "river"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "river-turn"
        },
        "ports": [
          {
            "name": "control",
            "port": 8443,
            "targetPort": "control"
          }
