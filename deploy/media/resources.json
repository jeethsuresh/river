{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "river-sfu",
        "namespace": "river"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "river-sfu"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "river-sfu"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "river-sfu",
                "image": "livekit/livekit-server:v1.13.10@sha256:89ca9ce0791e18d6e03bf6e2c49ceb27e1c754eae8bd50c989386c1a5963791a",
                "args": [
                  "--config",
                  "/run/river/config.yaml",
                  "--node-ip",
                  "$(POD_IP)"
                ],
                "ports": [
                  {
                    "name": "control",
                    "containerPort": 7880
                  },
                  {
                    "name": "media",
                    "containerPort": 7882,
                    "protocol": "UDP"
                  }
                ],
                "env": [
                  {
                    "name": "POD_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.podIP"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "300m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "300m",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/run/river",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 24
                },
                "readinessProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": "control"
                  },
                  "periodSeconds": 20,
                  "failureThreshold": 4
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "secret": {
                  "secretName": "river-sfu-config",
                  "defaultMode": 288
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "river-sfu",
        "namespace": "river"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "river-sfu"
        },
        "ports": [
          {
            "name": "control",
            "port": 7880,
            "targetPort": "control"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "river-turn",
        "namespace": "river"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "Recreate"
