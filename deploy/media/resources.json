    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "river-sfu",
        "namespace": "river",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.tls": "true"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "tls": [
          {
            "hosts": [
              "rtc.gravitas.cool"
            ]
          }
        ],
        "rules": [
          {
            "host": "rtc.gravitas.cool",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "river-sfu",
                      "port": {
                        "number": 7880
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "IngressRouteTCP",
      "metadata": {
        "name": "river-turn",
        "namespace": "river"
      },
      "spec": {
        "entryPoints": [
          "websecure"
        ],
        "routes": [
          {
            "match": "HostSNI(`turn.gravitas.cool`)",
            "services": [
              {
                "name": "river-turn",
                "port": 8443,
                "proxyProtocol": {
                  "version": 2
                }
              }
            ]
          }
        ],
        "tls": {}
      }
    },
